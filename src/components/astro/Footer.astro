---
// src/components/astro/Footer.astro
// Zero-client-JS port of src/components/Footer.jsx (v5 STATIC-01).
// Single-line footer: brand, name and location, social and email icons.
// Section navigation lives in the nav and the section pager, not here. Copyright year read at build time instead of React
// runtime (D-03).
const year = new Date().getFullYear()
const email = 'andresmontoyat@gmail.com'
const social = [
  { name: 'GitHub', href: 'https://github.com/andresmontoyat', icon: 'M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222 0 1.606-.014 2.898-.014 3.293 0 .322.216.694.825.576C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12' },
  { name: 'LinkedIn', href: 'https://www.linkedin.com/in/carlos-andres-montoya-tobon-8b508033/', icon: 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z' },
  { name: 'Blog', href: 'https://blog.andresmontoyat.dev/', icon: 'M4 3h13l3 3v15H4V3zm2 2v14h12V7h-2.5A1.5 1.5 0 0 1 14 5.5V5H6zm2 5h8v2H8v-2zm0 4h8v2H8v-2z' },
]
---
<footer class="border-t border-border mt-10">
  <div class="max-w-6xl mx-auto px-6 py-6 flex flex-col items-center gap-4 text-xs text-muted sm:flex-row sm:justify-between">
    <a href="#hero" class="font-pixel text-[10px] inline-flex items-center min-h-[24px] text-text hover:text-accent transition-colors duration-200">
      &lt;<span class="text-accent">/</span>camt&gt;
    </a>
    <p class="text-center">© {year} Carlos Andrés Montoya Tobón · Bogotá</p>
    <div class="flex items-center gap-2">
      {social.map((s) => (
        <a
          href={s.href}
          target="_blank"
          rel="noreferrer"
          title={s.name}
          aria-label={s.name}
          class="ft-ico inline-flex items-center justify-center w-10 h-10 rounded-full border border-border text-muted hover:text-accent hover:border-accent"
        >
          <svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor" aria-hidden="true"><path d={s.icon} /></svg>
        </a>
      ))}
      <a href={`mailto:${email}`} title={email} aria-label={`Email ${email}`} class="ft-ico inline-flex items-center justify-center w-10 h-10 rounded-full border border-border text-muted hover:text-accent hover:border-accent">
        <svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor" aria-hidden="true"><path d="M2 5.5A2.5 2.5 0 0 1 4.5 3h15A2.5 2.5 0 0 1 22 5.5v13a2.5 2.5 0 0 1-2.5 2.5h-15A2.5 2.5 0 0 1 2 18.5v-13zm2.3-.5L12 11.1 19.7 5H4.3zM20 6.9l-7.4 5.9a1 1 0 0 1-1.2 0L4 6.9v11.6c0 .3.2.5.5.5h15c.3 0 .5-.2.5-.5V6.9z" /></svg>
      </a>
    </div>
  </div>
</footer>

<style>
  .ft-ico { transition: color .2s, border-color .2s, translate .2s }
  @media (prefers-reduced-motion: no-preference) {
    .ft-ico:hover { translate: 0 -2px }
  }
</style>

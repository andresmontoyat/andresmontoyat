---
// src/components/astro/About.astro
// Zero-client-JS port of src/components/About.jsx (v5 STATIC-01).
// Count-up animation re-added per D-03 — closes Phase 23's D-04 deferral by
// wiring the numeric quick-fact (Experience) to the shared vanilla count-up
// enhancer module, the same one Hero.astro uses (D-02).
import data from '../../data/about.json'
import Sites from './Sites.astro'

const { locale } = Astro.props

function pick(field, lang) {
  if (typeof field === 'string') return field
  return field?.[lang] ?? field?.en ?? ''
}

function statParts(value) {
  const match = value.match(/\d+/)
  if (!match) return null
  const target = Number(match[0])
  const template = value.replace(/\d+/, '{n}')
  return { target, template }
}

const { facts } = data
const exp = facts.find((f) => f.id === 'exp')
const rest = facts.filter((f) => f.id !== 'exp')
---
<section id="about" class="py-20">
  <div class="max-w-6xl mx-auto px-6">
    <div class="font-pixel text-[10px] uppercase tracking-[1px] text-accent flex items-center gap-3 mb-4">
      <span class="block w-10 h-0.5 bg-accent" /> {pick(data.label, locale)}
    </div>
    <h2 class="font-pixel text-lg sm:text-xl md:text-2xl tracking-normal text-text mb-4 leading-tight sm:leading-7 md:leading-8">
      {pick(data.h2, locale)}
    </h2>
    <div class="grid lg:grid-cols-5 gap-10 mt-6">
      <div class="lg:col-span-3 space-y-4 text-muted text-base leading-relaxed">
        {data.paragraphs.map((p) => (
          <p>{pick(p, locale)}</p>
        ))}
      </div>
      <aside class="qf lg:col-span-2 self-start lg:sticky lg:top-24 bg-surface border border-border rounded-xl p-6 transition-colors duration-200 hover:border-accent/40">
        <div class="mb-5">
          <h3 class="text-base font-extrabold flex items-center gap-2 text-text whitespace-nowrap">
            <span class="text-accent">◆</span> {pick(data.quick, locale)}
          </h3>
        </div>
        {exp && (() => {
          const value = pick(exp.value, locale)
          const parts = statParts(value)
          return (
            <div class="qf-hero qf-card relative overflow-hidden rounded-lg bg-accent/[0.07] border border-accent/20 px-4 py-4 mb-4" style="--i: 0">
              <div class="text-[11px] uppercase tracking-widest text-muted">{pick(exp.kLabel, locale)}</div>
              <div class="flex items-baseline gap-2 flex-wrap mt-1">
                <span
                  class="text-4xl font-extrabold text-accent leading-none tabular-nums"
                  data-count-up={parts ? parts.target : undefined}
                  data-count-up-template={parts ? parts.template : undefined}
                >{value}</span>
                <span class="text-sm text-muted">{pick(data.expSub, locale)}</span>
              </div>
              <div class="text-sm text-text mt-2">{pick(data.expDetail, locale)}</div>
            </div>
          )
        })()}
        <ul class="grid grid-cols-2 gap-2">
          {rest.map((f, i) => (
            <li style={`--i: ${i + 1}`} class="qf-card qf-tile relative overflow-hidden group rounded-lg border border-border px-3 py-3 transition-all duration-200 hover:border-accent/50 hover:bg-accent/[0.05]">
              <div class="flex items-center gap-1.5 text-[11px] uppercase tracking-widest text-muted">
                <span class="qf-icon inline-block text-accent text-sm leading-none" aria-hidden="true">{f.icon}</span>{pick(f.kLabel, locale)}
              </div>
              <div class="mt-1 text-sm font-extrabold text-text group-hover:text-accent transition-colors">{pick(f.value, locale)}</div>
            </li>
          ))}
        </ul>
      </aside>
    </div>
    <Sites locale={locale} />
  </div>
</section>

<script src="../../scripts/count-up.js"></script>

<style>
  .qf-card::after { content: ''; position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(105deg, transparent 35%, color-mix(in srgb, var(--accent) 18%, transparent) 50%, transparent 65%);
    transform: translateX(-120%) }
  .qf-tile { transition: translate .25s cubic-bezier(.2,.7,.2,1), border-color .2s, background-color .2s, box-shadow .25s }
  .qf-icon { transition: transform .35s cubic-bezier(.3,1.6,.5,1) }
  .qf-hero [data-count-up] { transition: text-shadow .3s }

  @media (prefers-reduced-motion: no-preference) {
    .qf-card:hover::after { transform: translateX(120%); transition: transform .7s ease }
    .qf-tile:hover { translate: 0 -3px; box-shadow: 0 8px 22px -12px var(--accent) }
    .qf-tile:hover .qf-icon { transform: scale(1.35) rotate(-12deg) }
    .qf-hero:hover [data-count-up] { text-shadow: 0 0 18px color-mix(in srgb, var(--accent) 55%, transparent) }
    .qf-hero::before { content: ''; position: absolute; inset: -40%; pointer-events: none; opacity: .5;
      background: conic-gradient(from 0deg, transparent 0 80%, color-mix(in srgb, var(--accent) 22%, transparent) 90%, transparent);
      animation: qf-spin 7s linear infinite }
    .qf-hero > * { position: relative }
    @supports (animation-timeline: view()) {
      .qf-card { --scroll-tl: view(); animation: qf-in linear both; animation-timeline: var(--scroll-tl); animation-range: entry calc(var(--i) * 4%) entry calc(60% + var(--i) * 6%) }
    }
  }
  @keyframes qf-spin { to { transform: rotate(1turn) } }
  @keyframes qf-in { from { opacity: 0; transform: translateY(18px) scale(.97) } to { opacity: 1; transform: none } }
</style>

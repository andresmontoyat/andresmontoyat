---
// src/components/astro/Sites.astro
// The owner's other live sites, linked out. Rendered inside About. Zero client JS.
import data from '../../data/sites.json'

const { locale } = Astro.props
const pick = (field, lang) => (typeof field === 'string' ? field : field?.[lang] ?? field?.en ?? '')
const host = (url) => new URL(url).host
---
<div id="sites" class="mt-12 scroll-mt-24">
  <h3 class="text-base font-extrabold mb-2 flex items-center gap-2 text-text">
    <span class="text-accent">◆</span> {pick(data.h2, locale)}
  </h3>
  <p class="text-muted max-w-[60ch] mb-5 text-base leading-relaxed">{pick(data.intro, locale)}</p>
  <div class="grid gap-4 sm:grid-cols-2">
    {data.sites.map((site) => (
      <a
        href={site.url}
        target="_blank"
        rel="noopener noreferrer"
        class="group flex flex-col gap-1.5 rounded-xl border border-border bg-surface p-5 transition-all duration-200 hover:border-accent motion-safe:hover:-translate-y-1"
      >
        <span class="font-mono text-xs text-accent-2 break-all">{host(site.url)}</span>
        <span class="text-lg font-extrabold text-text">{pick(site.title, locale)}</span>
        <span class="text-base text-muted leading-relaxed">{pick(site.desc, locale)}</span>
        <span class="mt-auto pt-2 font-mono text-xs text-accent">{pick(data.cta, locale)} <span aria-hidden="true">→</span></span>
      </a>
    ))}
  </div>
</div>

---
// src/components/astro/Claude.astro
// AI engineering pitch: hero, interactive delivery pipeline, values and offerings.
// The pipeline is a tablist enhanced by claude-pipeline.js; without JS every stage renders stacked.
import data from '../../data/claude.json'

const { locale } = Astro.props
const GUIDES_URL = 'https://guidelines.andresmontoyat.dev/'

function pick(field, lang) {
  if (typeof field === 'string') return field
  return field?.[lang] ?? field?.en ?? ''
}
---
<section id="claude-code" class="py-24 sm:py-32" data-pipeline>
  <div class="max-w-6xl mx-auto px-6">
    <div class="grid lg:grid-cols-2 gap-10 items-center">
      <div>
        <p class="text-accent font-pixel text-[10px] uppercase tracking-[1px]">{pick(data.label, locale)}</p>
        <h2 class="font-pixel text-lg sm:text-xl md:text-2xl text-text mt-4 leading-snug sm:leading-7 md:leading-8">
          {pick(data.h2Part1, locale)}{' '}
          <span class="text-accent">{pick(data.h2Part2, locale)}</span>
        </h2>
        <p class="text-base leading-relaxed text-muted mt-6 max-w-[60ch]">{pick(data.subLead, locale)}</p>
        <div class="flex flex-col sm:flex-row gap-3 mt-8">
          <a href="#contact" class="bg-accent text-bg font-extrabold px-6 py-3 rounded-lg text-center transition-transform hover:-translate-y-0.5">
            {pick(data.ctaPrimary, locale)}
          </a>
          <a href={GUIDES_URL} target="_blank" rel="noopener noreferrer" class="border border-border text-text font-bold px-6 py-3 rounded-lg text-center transition-colors hover:border-accent">
            {pick(data.guidesCta, locale)} <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
      <div class="cp-box">
        <p class="cp-label">{pick(data.pipelineLabel, locale)}</p>
        <div class="cp-tabs" role="tablist" aria-label={pick(data.pipelineLabel, locale)}>
          {data.pipeline.map((s, i) => (
            <button type="button" role="tab" id={`cp-tab-${locale}-${s.id}`} aria-controls={`cp-panel-${locale}-${s.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
              <span class="cp-n">{String(i + 1).padStart(2, '0')}</span>{pick(s.title, locale)}
            </button>
          ))}
          <span class="cp-bar" aria-hidden="true"></span>
        </div>
        {data.pipeline.map((s, i) => (
          <div class="cp-panel" role="tabpanel" id={`cp-panel-${locale}-${s.id}`} aria-labelledby={`cp-tab-${locale}-${s.id}`} data-i={i}>
            <p class="cp-desc">{pick(s.desc, locale)}</p>
            <div class="cp-file">
              <div class="cp-head"><span class="cp-dots" aria-hidden="true"><i></i><i></i><i></i></span>{s.file}</div>
              <pre>{s.lines.map((l) => <span>{l}</span>)}</pre>
            </div>
          </div>
        ))}
        <p class="cp-hint">{pick(data.pipelineHint, locale)}</p>
      </div>
    </div>
    <div class="cp-rail grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mt-16" tabindex="0" aria-label={pick(data.valuesLabel, locale)}>
      {data.values.map((v) => (
        <div class="bg-surface border border-border rounded-xl p-5 hover:border-accent transition-colors">
          <div class="text-accent font-mono text-sm font-extrabold">{v.id}</div>
          <h3 class="text-text font-extrabold text-base mt-2">{pick(v.title, locale)}</h3>
          <p class="text-muted text-sm mt-2 leading-relaxed">{pick(v.desc, locale)}</p>
        </div>
      ))}
    </div>
    <p class="text-accent font-mono text-xs uppercase tracking-widest mt-14">
      {pick(data.offeringsLabel, locale)}
    </p>
    <div class="cp-rail grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mt-6" tabindex="0" aria-label={pick(data.offeringsLabel, locale)}>
      {data.offerings.map((o) => (
        <div class="group bg-surface border border-border rounded-xl p-5 hover:border-accent transition-colors">
          <h3 class="text-text font-extrabold text-base flex items-center gap-2">
            <span class="text-accent transition-transform group-hover:translate-x-0.5" aria-hidden="true">▸</span>{pick(o.title, locale)}
          </h3>
          <p class="text-muted text-sm mt-2 leading-relaxed">{pick(o.desc, locale)}</p>
        </div>
      ))}
    </div>
    <p class="text-accent font-mono text-xs uppercase tracking-widest mt-14">
      {pick(data.builtLabel, locale)}
    </p>
    <div class="cp-rail grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mt-6" tabindex="0" aria-label={pick(data.builtLabel, locale)}>
      {data.built.map((b) => (
        <a href={b.url} target="_blank" rel="noopener noreferrer" class="group flex flex-col bg-surface border border-border rounded-xl p-5 transition-all duration-200 hover:border-accent motion-safe:hover:-translate-y-1">
          <span class="text-text font-extrabold text-base flex items-center justify-between gap-2">{pick(b.title, locale)}<span class="text-accent transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" aria-hidden="true">↗</span></span>
          <span class="text-muted text-sm mt-2 leading-relaxed">{pick(b.desc, locale)}</span>
        </a>
      ))}
    </div>
  </div>
</section>

<script src="../../scripts/claude-pipeline.js"></script>

<style>
  .cp-box { position: relative; border-radius: 16px; background: var(--surface); border: 1px solid var(--border); padding: 20px; min-width: 0 }
  .cp-label { font: 11px var(--font-mono); text-transform: uppercase; letter-spacing: .12em; color: var(--muted); margin-bottom: 12px }
  .cp-tabs { position: relative; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 4px; padding-bottom: 10px; border-bottom: 2px solid var(--border) }
  .cp-tabs button { display: flex; flex-direction: column; align-items: flex-start; gap: 2px; padding: 6px 8px; border-radius: 8px; font: 700 13px var(--font-sans); color: var(--muted); text-align: left; min-height: 44px; transition: color .2s, background .2s }
  .cp-tabs button:hover { color: var(--text); background: var(--bg-2) }
  .cp-tabs button[aria-selected="true"] { color: var(--accent) }
  .cp-n { font: 11px var(--font-mono); opacity: .8 }
  .cp-bar { position: absolute; left: 0; bottom: -2px; height: 2px; width: 25%; background: var(--accent); transform: translateX(calc(var(--i, 0) * 100%)); transition: transform .35s cubic-bezier(.2,.7,.2,1) }
  .cp-bar::after { content: ''; position: absolute; inset: 0; background: var(--accent); transform-origin: left; transform: scaleX(var(--p, 0)); opacity: .35 }
  .cp-panel { padding-top: 16px }
  .cp-desc { color: var(--text); font-size: 15px; line-height: 1.6; min-height: 3.2em }
  .cp-file { margin-top: 14px; border-radius: 12px; overflow: hidden; background: var(--term, #0B1020); border: 1px solid var(--border) }
  .cp-head { display: flex; align-items: center; gap: 10px; padding: 8px 12px; font: 12px var(--font-mono); color: #9AA6C8; border-bottom: 1px solid rgba(255,255,255,.08) }
  .cp-dots { display: inline-flex; gap: 5px } .cp-dots i { width: 8px; height: 8px; border-radius: 50%; background: rgba(255,255,255,.18) }
  .cp-file pre { margin: 0; padding: 12px 14px; font: 12.5px/1.7 var(--font-mono); color: #DCE3FF; white-space: pre-wrap; overflow-wrap: anywhere; min-height: 8.6em }
  .cp-file pre span { display: block }
  .cp-hint { margin-top: 10px; font: 12px var(--font-mono); color: var(--muted) }
  [data-pipeline].js .cp-panel[hidden] { display: none }
  [data-pipeline].js .cp-file pre span { opacity: 0; transform: translateY(4px); animation: cp-in .3s forwards; animation-delay: calc(var(--d) * 90ms) }
  @keyframes cp-in { to { opacity: 1; transform: none } }
  @media (scripting: none) { .cp-tabs, .cp-hint { display: none } .cp-panel + .cp-panel { border-top: 1px solid var(--border); margin-top: 16px } }
  @media (max-width: 639px) {
    .cp-rail { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; margin-inline: -24px; padding: 2px 24px 10px; scroll-padding-inline: 24px; scrollbar-width: thin; overscroll-behavior-x: contain }
    .cp-rail > * { flex: 0 0 82%; scroll-snap-align: start }
    .cp-rail:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px }
  }
  @media (max-width: 480px) { .cp-tabs button { font-size: 12px; padding: 6px 4px } }
  @media (prefers-reduced-motion: reduce) { .cp-bar, .cp-bar::after { transition: none } [data-pipeline].js .cp-file pre span { animation: none; opacity: 1; transform: none } }
</style>

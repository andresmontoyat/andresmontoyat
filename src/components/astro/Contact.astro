---
// src/components/astro/Contact.astro
// Zero-client-JS port of src/components/Contact.jsx.
// HeroContact / RailItem sub-components inlined into templates (Astro
// components cannot be invoked as plain JS functions the way React
// sub-components were).
import data from '../../data/contact.json'

const { locale } = Astro.props

function pick(field, lang) {
  if (typeof field === 'string') return field
  return field?.[lang] ?? field?.en ?? ''
}

function linkAttrs(card) {
  return card.external ? { target: '_blank', rel: 'noopener noreferrer' } : {}
}

const hero = data.cards.find((c) => c.primary)
const rail = data.cards.filter((c) => !c.primary)
const heroLabel = pick(hero.kLabel, locale)
---
<section id="contact" class="py-20">
  <div class="max-w-6xl mx-auto px-6">
    <div class="font-pixel text-[10px] uppercase tracking-[1px] text-accent flex items-center gap-3 mb-4">
      <span class="block w-10 h-0.5 bg-accent" /> {pick(data.label, locale)}
    </div>
    <h2 class="font-pixel text-lg sm:text-xl md:text-2xl tracking-normal text-text mb-4 leading-tight sm:leading-7 md:leading-8">
      {pick(data.h2, locale)}
    </h2>
    <p class="text-muted max-w-[640px] mb-12 text-base leading-relaxed">{pick(data.intro, locale)}</p>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <a
        href={hero.href}
        {...linkAttrs(hero)}
        data-role="primary"
        class="group flex items-center gap-3 bg-surface border border-accent/40 rounded-xl px-5 py-3 transition-all duration-200 hover:-translate-y-0.5 hover:border-accent shadow-[0_0_24px_rgba(0,229,168,0.10)] hover:shadow-[0_0_36px_rgba(0,229,168,0.20)]"
      >
        <span class="w-7 shrink-0 text-center text-2xl leading-none text-accent" aria-hidden="true">{hero.icon}</span>
        <div class="min-w-0 flex-1">
          <div class="text-[11px] uppercase tracking-widest text-muted">{heroLabel} · <span class="text-accent">{pick(hero.cta, locale)}</span></div>
          <div class="text-sm font-extrabold text-text truncate" title={hero.value}>{hero.value}</div>
        </div>
        <span aria-hidden="true" class="shrink-0 text-accent text-xs font-mono transition-transform duration-200 group-hover:translate-x-1">→</span>
      </a>
      {rail.map((card) => {
        const label = pick(card.kLabel, locale)
        return (
          <a
            href={card.href}
            {...linkAttrs(card)}
            data-role="rail"
            class="group flex items-center gap-3 bg-surface border border-border rounded-xl px-5 py-3 transition-all duration-200 hover:-translate-y-0.5 hover:border-accent"
          >
            <span class="w-7 shrink-0 text-center text-lg text-accent" aria-hidden="true">{card.icon}</span>
            <div class="min-w-0 flex-1">
              <div class="text-[11px] uppercase tracking-widest text-muted">{label} · <span class="text-accent">{pick(card.cta, locale)}</span></div>
              <div class="text-sm font-extrabold text-text truncate">{card.value}</div>
            </div>
            <span aria-hidden="true" class="shrink-0 text-muted text-xs font-mono transition-all duration-200 group-hover:text-accent group-hover:translate-x-1">→</span>
          </a>
        )
      })}
    </div>
  </div>
</section>
